# EUMETSAT-Zugangsdaten (Consumer Key + Secret aus dem EUMETSAT Data Store).
# Überschreiben die in der Web-UI gespeicherten Werte, ohne sie zu
# persistieren. Für den normalen Betrieb reicht es, die Zugangsdaten
# einmalig über die Web-UI (http://<host>:6060/) einzugeben - diese Datei
# ist nur für Fälle gedacht, in denen die Zugangsdaten nicht im /data-
# Volume abgelegt werden sollen (z. B. Secrets-Management extern).
EUMETSAT_CONSUMER_KEY=
EUMETSAT_CONSUMER_SECRET=

# Pfad zur Konfigurationsdatei (Default: /data/config.yaml).
HA_SATELLITE_CONFIG=/data/config.yaml

# Basisverzeichnis für Frames/Konfiguration (Default: /data). Nur für
# Entwicklung/Tests relevant - im Container bleibt es beim gemounteten
# /data-Volume.
# HA_SATELLITE_DATA_DIR=/data

# UID/GID, mit der der Dienst läuft (Default 1000 = erster Benutzer auf dem
# Pi). Muss Schreibrechte auf den in der Web-UI gewählten Speicherort haben,
# z. B. einmalig: sudo install -d -o 1000 -g 1000 /mnt/data/ha_satellite
PUID=1000
PGID=1000

# Wurzelverzeichnisse, deren Unterordner die Web-UI als Speicherort vorschlägt.
# HA_SATELLITE_STORAGE_ROOTS=/mnt:/media

# Basis-URL der EUMETSAT Data Store API (Quellen-Abgleich, nur für Tests).
# HA_SATELLITE_EUMETSAT_API=https://api.eumetsat.int
